{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "server/src/**/*.ts",
    "server/tests/**/*.ts",
    "server/scripts/**/*.ts",
    "scripts/evals/**/*.ts"
  ]
}
