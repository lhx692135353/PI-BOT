{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pi Bot Desktop (Mac)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "desktop:dev"],
      "env": {
        "PI_BOT_SERVER_URL": "http://127.0.0.1:8000",
        "PI_BOT_HTTP_SERVER_URL": "http://127.0.0.1:8000",
        "PI_BOT_DATA_DIR": "${workspaceFolder}/.local/desktop-data",
        "PI_BOT_LIBRARY_ROOT": "${workspaceFolder}/.local/libraries"
      },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
