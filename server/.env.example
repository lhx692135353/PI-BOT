# 复制为 .env 后修改。Compose 用这里的管理员密码和 JWT 密钥；数据库地址在 compose 内会改写为 postgres 服务。
PI_BOT_DATABASE_URL=postgresql://pibot:pibot@localhost:5432/pibot
# 首次启动时创建的管理员；之后在 /admin 里管理用户，没有注册入口。
PI_BOT_ADMIN_USERNAME=admin
PI_BOT_ADMIN_PASSWORD=change-me-please
PI_BOT_JWT_SECRET=change-me-to-a-long-random-string-32chars
# 模型密钥加密文件：用 scripts/vault-key.ts 生成，只填路径。
PI_BOT_VAULT_FILE=/absolute/path/to/vault.json
# 可选
# PI_BOT_JWT_TTL_SECONDS=604800
# PI_BOT_LLM_TOKEN_TTL_SECONDS=900
# PI_BOT_SIGNATURE_SKEW_SECONDS=300
# PI_BOT_APPROVAL_TTL_SECONDS=900
# PI_BOT_RPC_TIMEOUT_MS=10000
# PI_BOT_HISTORY_LIMIT=40
# PI_BOT_MEMORY_THRESHOLD=60
# PI_BOT_ADMIN_DIR=/absolute/path/to/admin/dist

# Mac 离线时的云端回复（worker → runner）
PI_BOT_INTERNAL_URL=http://127.0.0.1:8000
PI_BOT_RUNNER_URL=http://127.0.0.1:8001
# Worker 与 Runner 共用，至少 32 字符；用 openssl rand -hex 32 生成。
PI_BOT_RUNNER_TOKEN=change-me-to-a-random-runner-token-32chars
# Mac 和云端共用 Tavily SaaS 搜索；只在服务端保存 Key，留空则不提供搜索工具。
# 额度按 Tavily 套餐与 Key 上限中较小的剩余值控制，不使用按量付费额度。
PI_BOT_TAVILY_API_KEY=
# PI_BOT_WORKER_LEASE_SECONDS=60
# PI_BOT_WORKER_POLL_SECONDS=1
# PI_BOT_RUNNER_DATA_DIR=/data

# 仅云端 Worker 使用 Langfuse 地址和凭据；API 只接收开关。
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=production

# Always-on：API 调度，Mac 在线才执行；每 Bot 按委托的本地日统计。
# PI_BOT_AUTOMATION_ROUND_SECONDS=300
# PI_BOT_AUTOMATION_MODEL_CALLS=20
# PI_BOT_AUTOMATION_DAILY_ROUNDS=96
# PI_BOT_AUTOMATION_PATROL_DAILY_ROUNDS=8

# Optional dedicated realtime voice model (does not change Bot text/summary models).
# Configure its enabled model UUID in the admin model list, using the same proxy
# base URL as PI_BOT_VOICE_REALTIME_URL. Never put an API key in the URL.
# PI_BOT_VOICE_MODEL_ID=00000000-0000-4000-8000-000000000000
# PI_BOT_VOICE_PROTOCOL=openai
# PI_BOT_VOICE_REALTIME_URL=wss://your-proxy.example/v1/realtime?model=gpt-realtime
