{
  "name": "@pi-bot/server",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.mjs",
    "worker": "node --env-file-if-exists=.env dist/worker.mjs",
    "runner": "node --env-file-if-exists=.env dist/runner.mjs",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "openapi": "node --import tsx scripts/export-openapi.ts",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@langfuse/client": "^5.10.0",
    "@novnc/novnc": "^1.7.0",
    "@pi-bot/a2ui": "*",
    "@pi-bot/agent": "*",
    "@pi-bot/bot-face": "*",
    "argon2": "^0.44.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "ssh2": "^1.17.0",
    "typebox": "1.3.27",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "esbuild": "0.28.2"
  },
  "license": "Apache-2.0"
}
